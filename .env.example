# ── Supabase (la integración de Vercel carga estas cuatro sola) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# ── Acceso (login con Google; se dan de alta solos en cada deploy) ──
ADMIN_EMAILS=
EDITOR_EMAILS=
LECTOR_EMAILS=

# ── Secretos de máquina (40+ caracteres: openssl rand -hex 32) ──
CRON_SECRET=
CARGA_API_TOKEN=

# ── Fuentes de datos ──
GHL_TOKEN=
GHL_LOCATION_ID=qcLzgJ0LSGXkHKb4pkHn
# Secreto del webhook de GHL (cualquier texto largo). Va en la URL del webhook: /api/webhooks/ghl?token=...
GHL_WEBHOOK_SECRET=
META_TOKEN=
META_AD_ACCOUNT=act_1431751731204204
# Opcional: se saca solo de META_PAGE_ID. (1696198744016068 es la página de Facebook, no la cuenta de Instagram)
IG_USER_ID=
# Página de Facebook conectada al Instagram (para leer los DMs y medir el tiempo de respuesta)
META_PAGE_ID=1696198744016068

# ── Google Search Console (verificación de marca del login) ──
GOOGLE_SITE_VERIFICATION=

# ── Resumen semanal por mail (viernes 18:00 AR) ──
# API key de resend.com. Sin dominio verificado, Resend solo deja mandar al mail dueño de la cuenta.
RESEND_API_KEY=
# A quién se manda (separados por coma). Vacío = a todos los admin de la tabla usuarios.
RESUMEN_EMAILS=
# Remitente. Con dominio verificado en Resend: "Speak Sellers <resumen@tudominio.com>"
RESUMEN_DESDE=Speak Sellers <onboarding@resend.dev>
APP_URL=https://speak-sellers-dashboard.vercel.app
