# Variables de entorno del dashboard. Todo lo que NO es secreto (marca, closers, IDs de GHL y Meta)
# va en cliente.json. Acá van solo claves y listas de emails. Se cargan en Vercel → Settings → Environment Variables.

# ── Supabase (la integración de Vercel carga estas cuatro sola) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# ── Acceso (login con Google; se dan de alta solos en cada deploy) ──
ADMIN_EMAILS=
EDITOR_EMAILS=
LECTOR_EMAILS=

# ── Secretos de máquina (40+ caracteres: openssl rand -hex 32) ──
CRON_SECRET=
CARGA_API_TOKEN=

# ── GoHighLevel (token de Private Integration, empieza con pit-) ──
GHL_TOKEN=
# Secreto del webhook de citas (cualquier texto largo). Va en la URL del webhook: /api/webhooks/ghl?token=...
GHL_WEBHOOK_SECRET=
# Opcional: pisa ghl.locationId de cliente.json
GHL_LOCATION_ID=

# ── Meta (token de usuario del sistema con ads_read, instagram_basic, instagram_manage_insights, pages_read_engagement, pages_show_list, business_management) ──
META_TOKEN=
# Opcionales: pisan meta.cuentaPublicitaria y meta.paginaId de cliente.json
META_AD_ACCOUNT=
META_PAGE_ID=
# Opcional: ID de la cuenta de Instagram (1784…) si no hay página de Facebook conectada
IG_USER_ID=

# ── Google Search Console (verificación de marca del login). Opcional: pisa googleSiteVerification de cliente.json ──
GOOGLE_SITE_VERIFICATION=

# URL pública del dashboard. Opcional: pisa url de cliente.json
APP_URL=

# ManyChat (opcional): Settings → API. Solo lectura de etiquetas y fechas de los contactos.
MANYCHAT_TOKEN=
